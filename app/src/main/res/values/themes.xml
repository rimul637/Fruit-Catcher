<resources>
    <string name="app_name">Fruit Catcher</string>
    <style name="Theme.FruitCatcher" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#133622</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.FruitCatcher.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#133622</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.FruitCatcher</item>
    </style>
</resources>
